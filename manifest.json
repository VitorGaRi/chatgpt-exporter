{
  "manifest_version": 3,
  "name": "ChatGPT Exporter",
  "version": "2.2.1",
  "key": "",
  "description": "Exports the open ChatGPT conversation, in full, to a file (currently Markdown)",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ChatGPT Exporter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
